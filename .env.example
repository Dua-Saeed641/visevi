# Copy this file to .env and fill in real values. Never commit .env.

# ── Cloudinary ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: single-string form Cloudinary SDKs also accept
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ── Database (MongoDB Connection String) ─────────────────────
DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/visevi?retryWrites=true&w=majority

# ── Disaster watch (all optional) ────────────────────────────
# Google Maps Platform key with the Weather API enabled. Without it,
# temperature falls back to Open-Meteo (keyless) and the UI says so.
GOOGLE_MAPS_API_KEY=
# Minutes between automatic sensor polls (default 15 with a key, off without).
# SENSOR_POLL_MINUTES=15
# If set, POST /api/signals/ingest from a real sensor needs header x-sensor-key.
# SENSOR_WEBHOOK_SECRET=

# ── Automatic response loop (all optional) ───────────────────
# Where the client is served; notifications link straight to an alert there.
# CLIENT_URL=https://your-app.vercel.app
# Email delivery through any SMTP server (Gmail: smtp.gmail.com, port 587, an app password).
# Without it, notifications are recorded in the app and ntfy push still works.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=VisEvi <alerts@example.org>
# Set to "off" to stop alerts fetching a fresh NASA satellite snapshot on their own.
# AUTO_CAPTURE=on

# ── (Unused) LLM provider — verification, indicators, search and change narrative are deterministic server code; no key needed ──
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── Server ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=

# This file lives at repo root and is what server/ reads (server/src/env.ts
# loads it via `../.env`). The client reads its own client/.env.local
# instead — see client/.env.example — because Vite scopes env loading to
# the client/ directory by default.
