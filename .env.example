# Copy this file to .env and fill in real values. Never commit .env.

# ── Cloudinary ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: single-string form Cloudinary SDKs also accept
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/visevi

# ── AI / LLM provider (embeddings + report generation) ───────
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── Server ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=

# ── Client ───────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:4000
